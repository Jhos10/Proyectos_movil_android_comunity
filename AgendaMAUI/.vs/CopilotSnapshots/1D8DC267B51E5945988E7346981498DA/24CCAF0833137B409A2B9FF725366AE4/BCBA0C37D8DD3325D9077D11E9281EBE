using Microsoft.Maui.Controls;
using AgendaMAUI.Models;

namespace AgendaMAUI.Pages;

public partial class ContactFormPage : ContentPage
{
    public ContactFormPage(Contact contact)
    {
        InitializeComponent();
        BindingContext = contact;
    }

    private async void OnSaveClicked(object sender, EventArgs e)
    {
        // Validar en el code-behind para notificar al usuario si falta info
        var contact = BindingContext as Contact;
        if (contact == null)
            return;

        var missing = new System.Collections.Generic.List<string>();
        if (string.IsNullOrWhiteSpace(contact.Name)) missing.Add("Nombre");
        if (string.IsNullOrWhiteSpace(contact.Phone)) missing.Add("Teléfono");
        if (string.IsNullOrWhiteSpace(contact.Email)) missing.Add("Email");

        if (missing.Count > 0)
        {
            string msg = "Los siguientes campos son obligatorios: " + string.Join(", ", missing);
            await Shell.Current.DisplayAlert("Error", msg, "OK");
            return;
        }

        // Cerrar y devolver resultado
        await Shell.Current.GoToAsync("..", true);
        // Para simplicidad, guardado lo hará el ViewModel al recibir control de nuevo.
    }

    private async void OnCancelClicked(object sender, EventArgs e)
    {
        await Shell.Current.GoToAsync("..", true);
    }
}
