<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:AgendaMAUI.ViewModels"
             x:Class="AgendaMAUI.Views.ContactFormPage"
             Title="Contacto">

    <ContentPage.BindingContext>
        <viewmodel:ContactFormViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Entry Placeholder="Nombre" Text="{Binding Name}" />
            <Entry Placeholder="Teléfono" Text="{Binding Phone}" Keyboard="Telephone" />
            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />

            <HorizontalStackLayout Spacing="10">
                <Button Text="Guardar" Command="{Binding SaveCommand}" BackgroundColor="Green" TextColor="White" />
                <Button Text="Cancelar" Command="{Binding CancelCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
