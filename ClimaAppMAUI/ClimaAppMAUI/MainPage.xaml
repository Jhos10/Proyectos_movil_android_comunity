<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClimaAppMAUI.MainPage">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30">

            <Label Text="CLIMA ACTUAL"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#2c3e50"/>

            <Label Text="{Binding Condition}"
                   FontSize="24"
                   HorizontalOptions="Center"
                   TextColor="#34495e"/>

            <Grid ColumnDefinitions="*,*" Padding="0,20">

                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                    <Label Text=" 🌡️ Temperatura" FontSize="14" TextColor="Gray"/>
                    <Label Text="{Binding Temperature, StringFormat='{0:F1}°C'}"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#e74c3c"/>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                    <Label Text=" 💧 Humedad" FontSize="14" TextColor="Gray"/>
                    <Label Text="{Binding Humidity, StringFormat='{0}%'}"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#3498db"/>
                </VerticalStackLayout>

            </Grid>

            <Button Text="Actualizar Clima"
                    Clicked="OnActualizarClicked"
                    BackgroundColor="#f39c12"
                    TextColor="White"
                    CornerRadius="10"
                    FontAttributes="Bold"
                    Margin="0,30,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
